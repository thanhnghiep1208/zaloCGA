rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return signedIn() && userRole() == "admin";
    }

    function isContributorOrAdmin() {
      return signedIn()
        && (userRole() == "contributor" || userRole() == "admin");
    }

    // Chat history: each user can only access their own sessions.
    match /chatSessions/{sessionId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // User profile + role documents (users cannot self-elevate role).
    match /users/{userId} {
      allow read: if ownUserDoc(userId) || isAdmin();

      // Create: own doc as normal user, OR admin creating canonical users/{auth.uid} (uid field must match doc id).
      // Bootstrap: one designated Google account may create their own doc with role "admin" (matches Auth JWT email).
      allow create: if ownUserDoc(userId)
        && (!request.resource.data.keys().hasAny(["role"])
            || request.resource.data.role == "user"
            || (request.resource.data.role == "admin"
                && request.auth.token.email != null
                && request.auth.token.email == "thanhnghiep1208@gmail.com"))
        || (isAdmin()
            && request.resource.data.uid == userId);

      // Update: admin may change anything; user may not change role field (except bootstrap email may set admin once if still user).
      allow update: if isAdmin()
        || (ownUserDoc(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]))
        || (ownUserDoc(userId)
            && resource.data.role == "user"
            && request.resource.data.role == "admin"
            && request.auth.token.email != null
            && request.auth.token.email == "thanhnghiep1208@gmail.com"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"]));

      allow delete: if isAdmin();
    }

    // Knowledge documents.
    match /documents/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isContributorOrAdmin();
    }

    // Analytics events are server-written. Admin can read for dashboard.
    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
