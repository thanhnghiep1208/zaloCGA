rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return signedIn() && userRole() == "admin";
    }

    function isContributorOrAdmin() {
      return signedIn()
        && (userRole() == "contributor" || userRole() == "admin");
    }

    // Login device/browser sessions (not chat conversations).
    match /authSessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.revoked == false;

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if signedIn() && (
        (resource.data.userId == request.auth.uid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt'])
            || (
              request.resource.data.revoked == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt'])
            )
          ))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt']))
      );

      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Chat history: owner access; contributor/admin read for analytics dashboard.
    match /chatSessions/{sessionId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isContributorOrAdmin());
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // User profiles are admin-provisioned only (no self-registration).
    match /users/{userId} {
      allow read: if ownUserDoc(userId) || isContributorOrAdmin();

      allow create: if isAdmin()
        && request.resource.data.uid == userId;

      allow update: if isAdmin()
        || (ownUserDoc(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "role", "username", "uid", "email", "createdAt", "createdBy"
            ]));

      allow delete: if isAdmin();
    }

    // Knowledge documents.
    match /documents/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isContributorOrAdmin();
    }

    // Analytics events are server-written. Contributor/admin can read for dashboard.
    match /analyticsEvents/{eventId} {
      allow read: if isContributorOrAdmin();
      allow write: if false;
    }
  }
}
