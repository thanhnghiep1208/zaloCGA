# Copy to .env.local for local dev. In production use Firebase App Hosting env / secrets.

# Firebase client (required at build + runtime)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Username login maps to {username}@<domain> — BOTH must be set to the SAME value in production.
NEXT_PUBLIC_INTERNAL_AUTH_EMAIL_DOMAIN=accounts.internal
INTERNAL_AUTH_EMAIL_DOMAIN=accounts.internal

# Server-only
GEMINI_API_KEY=
# Optional: override chat model list (comma-separated). Default: gemini-3.7-flash, then fallbacks.
# GEMINI_CHAT_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview
FIREBASE_SERVICE_ACCOUNT_KEY=
CHAT_ATTACHMENTS_CRON_SECRET=

# Optional
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_ID=
