# Copy to .env.local for local dev. In production use Firebase App Hosting env / secrets.

# Firebase client (required at build + runtime)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Username login maps to {username}@<domain> — BOTH must be set to the SAME value in production.
NEXT_PUBLIC_INTERNAL_AUTH_EMAIL_DOMAIN=accounts.internal
INTERNAL_AUTH_EMAIL_DOMAIN=accounts.internal

# Server-only
GEMINI_API_KEY=
# Optional: override chat model list (comma-separated). Default: gemini-3.8-flash, then fallbacks.
# GEMINI_CHAT_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview
FIREBASE_SERVICE_ACCOUNT_KEY=
CHAT_ATTACHMENTS_CRON_SECRET=

# Optional
# Canonical URL for metadata/OG images. Set this in production; defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
# Contact shown on /login for account requests (hidden when both are unset)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ZALO=
NEXT_PUBLIC_GA_ID=

# Optional retrieval tuning — defaults were measured with scripts/eval-retrieval.mjs
# (see src/lib/retrieval/eval/BASELINE.md). Leave unset unless you re-measured.
# RETRIEVAL_RRF_WEIGHT_LEXICAL=0          # >0 measured to hurt recall/MRR on this corpus
# RETRIEVAL_RELEVANCE_CHECK_ENABLED=0     # disables the LLM "not found" check
# Full list: docs/PROJECT_OVERVIEW.md section 9.

# Optional: accounts for authenticated Playwright e2e tests (skipped when unset)
# E2E_USER_USERNAME=
# E2E_USER_PASSWORD=
# E2E_ADMIN_USERNAME=
# E2E_ADMIN_PASSWORD=
