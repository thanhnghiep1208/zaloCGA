rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Must use firestore.exists / firestore.get — plain exists() is NOT for Firestore paths in Storage rules.
    function userDoc() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userRole() {
      return firestore.exists(userDoc())
        ? firestore.get(userDoc()).data.role
        : "user";
    }

    function isContributorOrAdmin() {
      return signedIn() && (userRole() == "contributor" || userRole() == "admin");
    }

    // Upload area used by Admin Upload page: documents/*
    match /documents/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isContributorOrAdmin();
    }
  }
}
